{
  "name": "pipong",
  "description": "API Service for Notification",
  "version": "0.0.3",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check": "uncheck",
    "prepare": "uncheck prepare --pre-commit",
    "test": "pnpm --recursive --if-present run test",
    "test:watch": "pnpm --recursive --parallel --if-present run test:watch",
    "test:verbose": "pnpm --recursive --if-present run test:verbose",
    "release": "genbumppush --yes",
    "server": "pnpm --filter pipong-server --fail-if-no-match run",
    "worker": "pnpm --filter pipong-worker --fail-if-no-match run",
    "auth": "pnpm --filter @pipong/auth --fail-if-no-match run",
    "database": "pnpm --filter @pipong/database --fail-if-no-match run",
    "service": "pnpm --filter @pipong/service --fail-if-no-match run",
    "shared": "pnpm --filter @pipong/shared --fail-if-no-match run",
    "migrate": "pnpm database migrate"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:root",
    "@types/node": "catalog:shared",
    "genbumppush": "catalog:root",
    "oxfmt": "catalog:root",
    "oxlint": "catalog:root",
    "oxlint-tsgolint": "catalog:root",
    "typescript": "catalog:shared",
    "uncheck": "catalog:root"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0"
}
