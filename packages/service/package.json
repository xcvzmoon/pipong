{
  "name": "@pipong/service",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --checkers 8",
    "test": "vitest run"
  },
  "dependencies": {
    "@pipong/auth": "workspace:*",
    "@pipong/database": "workspace:*",
    "ipaddr.js": "catalog:",
    "valibot": "catalog:shared",
    "web-push": "catalog:",
    "uuid": "catalog:shared"
  },
  "devDependencies": {
    "@types/node": "catalog:shared",
    "@types/web-push": "catalog:",
    "tsdown": "catalog:shared",
    "typescript": "catalog:shared",
    "vitest": "catalog:shared",
    "pg": "catalog:database",
    "@types/pg": "catalog:database"
  }
}
