{
  "name": "@pipong/auth",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --checkers 8",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:verbose": "vitest --run --reporter=verbose",
    "generate:schema": "auth generate --config tooling/auth.config.ts --output ../database/tooling/auth-schema.generated.ts --yes"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:auth",
    "@better-auth/drizzle-adapter": "catalog:auth",
    "@pipong/database": "workspace:*",
    "@pipong/shared": "workspace:*",
    "@xcvzlabs/env": "catalog:shared",
    "better-auth": "catalog:auth",
    "handlebars": "catalog:mail",
    "pg-boss": "catalog:mail",
    "unemail": "catalog:mail",
    "uuid": "catalog:shared",
    "valibot": "catalog:shared"
  },
  "devDependencies": {
    "@types/node": "catalog:shared",
    "auth": "catalog:auth",
    "tsdown": "catalog:shared",
    "typescript": "catalog:shared",
    "vitest": "catalog:shared"
  }
}
