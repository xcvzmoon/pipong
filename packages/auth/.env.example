NODE_ENV="development"

# API authentication settings. Replace the sample secret before deployment.
AUTH_BASE_URL="http://localhost:3000"
AUTH_SECRET="local-development-secret-replace-before-deployment"

# Worker email settings. These defaults require a local SMTP capture server.
AUTH_MAIL_FROM="auth@example.com"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURITY="local"
# SMTP_USER="your-smtp-login"
# SMTP_PASSWORD="your-smtp-password"

# Migration tooling only. Never inject this credential into API or worker processes.
MIGRATION_DATABASE_URL="postgres://pipong_migrator@localhost:5432/pipong"
