{
  "name": "@pipong/database",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./authorization": "./src/authorization/index.ts",
    "./environments": "./src/environments/index.ts",
    "./helpers": "./src/helpers/index.ts",
    "./projects": "./src/projects/index.ts",
    "./recipients": "./src/recipients/index.ts",
    "./service-keys": "./src/service-keys/index.ts",
    "./tenancy": "./src/tenancy/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./auth": "./dist/auth/index.mjs",
      "./authorization": "./dist/authorization/index.mjs",
      "./environments": "./dist/environments/index.mjs",
      "./helpers": "./dist/helpers/index.mjs",
      "./projects": "./dist/projects/index.mjs",
      "./recipients": "./dist/recipients/index.mjs",
      "./service-keys": "./dist/service-keys/index.mjs",
      "./tenancy": "./dist/tenancy/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --checkers 8",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate --config drizzle.migrate.config.ts && drizzle-kit migrate --config drizzle.auth.migrate.config.ts && drizzle-kit migrate --config drizzle.tenancy.migrate.config.ts",
    "check": "drizzle-kit check && drizzle-kit check --config drizzle.auth.config.ts && drizzle-kit check --config drizzle.tenancy.config.ts",
    "studio:api": "drizzle-kit studio --config drizzle.api.config.ts",
    "studio:worker": "drizzle-kit studio --config drizzle.worker.config.ts",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:verbose": "vitest --run --reporter=verbose",
    "generate:auth": "drizzle-kit generate --config drizzle.auth.config.ts",
    "generate:tenancy": "drizzle-kit generate --config drizzle.tenancy.config.ts"
  },
  "dependencies": {
    "@pipong/shared": "workspace:*",
    "@xcvzlabs/env": "catalog:shared",
    "drizzle-orm": "catalog:database",
    "drizzle-query-logger": "catalog:shared",
    "pg": "catalog:database",
    "uuid": "catalog:shared",
    "valibot": "catalog:shared",
    "pg-boss": "catalog:mail"
  },
  "devDependencies": {
    "@types/node": "catalog:shared",
    "@types/pg": "catalog:database",
    "drizzle-kit": "catalog:database",
    "tsdown": "catalog:shared",
    "typescript": "catalog:shared",
    "vitest": "catalog:shared"
  }
}
