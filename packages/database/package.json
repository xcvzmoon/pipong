{
  "name": "@pipong/database",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --checkers 8",
    "generate": "drizzle-kit generate",
    "migrate": "pnpm --filter pipong-worker --fail-if-no-match run migrate",
    "pull": "drizzle-kit pull",
    "studio": "drizzle-kit studio",
    "check": "drizzle-kit check",
    "test": "vitest --run"
  },
  "dependencies": {
    "@pipong/shared": "workspace:*",
    "@xcvzlabs/env": "catalog:shared",
    "drizzle-orm": "catalog:database",
    "pg": "catalog:database",
    "valibot": "catalog:shared"
  },
  "devDependencies": {
    "@types/node": "catalog:shared",
    "@types/pg": "catalog:database",
    "drizzle-kit": "catalog:database",
    "tsdown": "catalog:shared",
    "typescript": "catalog:shared",
    "vitest": "catalog:shared"
  }
}
