{
  "name": "@pipong/database",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --checkers 8",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate --config drizzle.migrate.config.ts",
    "check": "drizzle-kit check",
    "studio:api": "drizzle-kit studio --config drizzle.api.config.ts",
    "studio:worker": "drizzle-kit studio --config drizzle.worker.config.ts",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:verbose": "vitest --run --reporter=verbose"
  },
  "dependencies": {
    "@xcvzlabs/env": "catalog:shared",
    "drizzle-orm": "catalog:database",
    "pg": "catalog:database",
    "valibot": "catalog:shared",
    "drizzle-query-logger": "catalog:shared",
    "@pipong/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:shared",
    "@types/pg": "catalog:database",
    "drizzle-kit": "catalog:database",
    "tsdown": "catalog:shared",
    "typescript": "catalog:shared",
    "vitest": "catalog:shared"
  }
}
