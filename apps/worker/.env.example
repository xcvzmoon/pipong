NODE_ENV="development"

CREDENTIAL_KEYRING_REF="vault://pipong/credentials"
APNS_ENVIRONMENT="sandbox"

# Set these when enabling their providers.
# FCM_PROJECT_ID="your-project-id"
# WEB_PUSH_SUBJECT="mailto:operator@example.com"

# Authentication email. Local capture server only.
AUTH_MAIL_FROM="auth@example.com"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURITY="local"
# SMTP_USER="your-smtp-login"
# SMTP_PASSWORD="your-smtp-password"

# Worker runtime connection. Provision roles and run pnpm migrate first.
WORKER_DATABASE_URL="postgres://pipong_worker@localhost:5432/pipong"
WORKER_DATABASE_MAX_POOL="12"
WORKER_DATABASE_CONNECTION_TIMEOUT="5000"
WORKER_DATABASE_IDLE_TIMEOUT="30000"
WORKER_DATABASE_APPLICATION_NAME="pipong_worker"
WORKER_DATABASE_USE_QUERY_LOGGER="false"
