    "@types/node": "catalog:shared",
    "@types/pg": "catalog:database",
    "@types/smtp-server": "catalog:mail",
    "better-auth": "catalog:auth",
    "nitro": "catalog:server",
    "pg": "catalog:database",
    "smtp-server": "catalog:mail",
    "typescript": "catalog:shared",
    "valibot": "catalog:shared",
    "vitest": "catalog:shared"
