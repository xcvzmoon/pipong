NODE_ENV="development"

AUTH_BASE_URL="http://localhost:3000"
AUTH_SECRET="local-development-secret-replace-before-deployment"
CREDENTIAL_KEYRING_REF="vault://pipong/credentials"

# API runtime connection. Provision roles and run pnpm migrate first.
API_DATABASE_URL="postgres://pipong_api@localhost:5432/pipong"
API_DATABASE_MAX_POOL="8"
API_DATABASE_CONNECTION_TIMEOUT="5000"
API_DATABASE_IDLE_TIMEOUT="30000"
API_DATABASE_APPLICATION_NAME="pipong_api"
API_DATABASE_USE_QUERY_LOGGER="false"
